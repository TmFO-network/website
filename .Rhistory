read_tsv("data/sites.csv") |>
st_as_sf(coords = c("lon", "lat"), crs = "EPSG:32621") |>
leaflet() %>%
addTiles() %>%
addProviderTiles("Esri.WorldImagery", group = "ESRI") %>%
addMarkers(
label = ~ paste(site, parcelle),
labelOptions = labelOptions(noHide = FALSE)
)
