""
)
img_candidates <- file.path(img_dir, paste0(slug, ".", img_ext))
image <- img_candidates[file.exists(img_candidates)][1]
text  <- file.path(content_dir, paste0(slug, ".md"))
if (!is.na(image) || file.exists(text)) {
lines <- c(lines, "## About this site {#about}", "")
if (!is.na(image)) {
lines <- c(lines,
paste0("![](../site-content/images/", basename(image), "){fig-alt=", yaml_str(r$site), " .img-fluid}"),
"")
}
if (file.exists(text)) {
lines <- c(lines, paste0("{{< include ../site-content/", basename(text), " >}}"), "")
}
con <- file(file.path(out_dir, paste0(slug, ".qmd")), open = "wb")
writeLines(enc2utf8(lines), con, useBytes = TRUE)
close(con)
