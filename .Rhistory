#!/usr/bin/env Rscript
# Generates one Quarto page per site listed in sites.csv (runs as a Quarto pre-render step).
#
# Each page has:
#   1. an auto-generated "Site information" bullet list built from the CSV row
#      (empty cells are simply left out)
#   2. an optional "About this site" section made of
#        - site-content/images/<slug>.(jpg|jpeg|png|webp|gif|svg)   (optional image)
#        - site-content/<slug>.md                                    (optional free text)
#
# <slug> is the site name in lowercase ASCII with hyphens,
# e.g. "Example Site A" -> example-site-a
#
# Quarto runs pre-render scripts from the project root, so paths are relative to it.
source("scripts/utils.R")
source("D:/github/website/r/generate_sites.R")
