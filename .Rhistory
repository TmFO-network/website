dec_to_dms <- function(lat, lon) {
# Helper function to convert a single numeric coordinate to DMS components
convert_coord <- function(val, is_lat) {
if (is.na(val)) return(NA_character_)
# Determine the hemisphere suffix
if (is_lat) {
suffix <- ifelse(val >= 0, "N", "S")
} else {
suffix <- ifelse(val >= 0, "E", "W")
}
# Work with absolute value for the math
abs_val <- abs(val)
# Calculate Degrees, Minutes, and Seconds
deg <- floor(abs_val)
min_val <- (abs_val - deg) * 60
min <- floor(min_val)
sec <- round((min_val - min) * 60, 2)
# Handle rounding overflow (e.g., 59.999 seconds becoming 60)
if (sec >= 60) {
sec <- 0
min <- min + 1
}
if (min >= 60) {
min <- 0
deg <- deg + 1
}
# Format as a clean string
return(sprintf("%d° %d' %.2f\" %s", deg, min, sec, suffix))
}
# Vectorize the helper function so it works on vectors/dataframe columns
lat_dms <- mapply(convert_coord, lat, TRUE, USE.NAMES = FALSE)
lon_dms <- mapply(convert_coord, lon, FALSE, USE.NAMES = FALSE)
# Return a data frame with both formatted coordinates
return(data.frame(lat_dms = lat_dms, lon_dms = lon_dms, stringsAsFactors = FALSE))
}
# Metadata fields shown on each site page, in this order.
# A field whose cell in sites.csv is empty is left out of the page.
info_fields <- c(
nb_control = "Control plots",
nb_logged  = "Logged plots",
plot_size  = "Plot size",
years   = "Inventory period",
nb_census   = "Last inventory",
coords        = "Coordinates",
url = "Website"
)
# "Site information" section as a bullet list; no section at all if every field is empty
info_section <- function(r) {
vals <- vapply(names(info_fields), function(k) {
v <- r[[k]]
if (is.null(v) || is.na(v)) "" else trimws(gsub("[\r\n]+", " ", v))
}, character(1))
keep <- vals != ""
if (!any(keep)) return(character(0))
c("## Site information {#site-information}", "",
paste0("- **", info_fields[keep], ":** ", vals[keep]), "")
}
