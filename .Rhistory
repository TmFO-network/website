yaml_str <- function(x) paste0('"', gsub('"', '\\\\"', gsub("\\", "\\\\", x, fixed = TRUE)), '"')
sites <- read_sites("data/sites.csv")
slugs <- slugify(sites$site)
dups <- unique(slugs[duplicated(slugs)])
if (length(dups)) {
stop("Several sites give the same page name: ", paste(dups, collapse = ", "))
}
dir.create(out_dir, showWarnings = FALSE)
# remove stale generated pages
for (f in list.files(out_dir, pattern = "\\.qmd$", full.names = TRUE)) {
if (any(grepl(marker, readLines(f, warn = FALSE, encoding = "UTF-8"), fixed = TRUE))) file.remove(f)
}
sites
sites$site
i=18
r    <- sites[i, ]
slug <- slugs[i]
lines <- c(
"---",
paste0("title: ", yaml_str(r$site)),
"---",
"",
marker,
"",
"[\u2190 Back to the map](../sites.html)",
"",
"## Site information {#site-information}",
"",
"| Property | Value |",
"|:---------|:------|",
paste0("| ", table_fields, " | ",
vapply(names(table_fields), function(k) md_cell(r[[k]]), ""), " |"),
""
)
img_candidates <- file.path(img_dir, paste0(slug, ".", img_ext))
img_candidates
image <- img_candidates[file.exists(img_candidates)][1]
image
