# create site-level data
tmfo_sites <- c("Antimary", "BAFOG", "Ecosilva", "Iracema", "Iwokrama", "Jari",
"Jenaro Herrera", "Kabo", "Malinau", "Manare", "Mbaiki", "Mil",
"Misiones", "Moju", "Montagne Tortue", "Chico Bocao", "Cumaru",
"Tabocal", "Paracou", "Peixoto", "Peteco", "Sao Nicolau",
"STREK", "Tapajos Km67", "Tapajos Km114", "Tene", "SUAS")
read.csv("cache/bioforest-plot-information.csv") |>
mutate(site = gsub(" APU.|Pad Limo |Pad Limoeiro ", "", site)) |>
filter(site %in% tmfo_sites) |>
group_by(site) |>
summarise(latitude = mean(latitude), longitude = mean(longitude))
read.csv("cache/bioforest-plot-information.csv") |>
mutate(site = gsub(" APU.|Pad Limo |Pad Limoeiro ", "", site)) |>
filter(site %in% tmfo_sites) |>
group_by(site) |>
summarise(latitude = mean(latitude), longitude = mean(longitude)) |>
write.csv("data/sites.csv", row.names = FALSE)
read.csv("cache/bioforest-plot-information.csv") |>
mutate(site = gsub(" APU.|Pad Limo |Pad Limoeiro ", "", site)) |>
